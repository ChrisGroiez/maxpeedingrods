---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/home/Hero.astro';
import TrustBanner from '../../components/home/TrustBanner.astro';
import FeaturedProducts from '../../components/home/FeaturedProducts.astro';
import WhyChoose from '../../components/home/WhyChoose.astro';
import HomeReviews from '../../components/home/HomeReviews.astro';
import StructuredData from '../../components/seo/StructuredData.astro';
import { locales, type Locale } from '../../i18n/utils';
import { homeSEO } from '../../config/seo';
import { siteConfig } from '../../config/site';

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;
const seo = homeSEO[locale];

// SEO texts — 200-250 words, unique per language, targeting remaining secondary keywords
const seoTexts: Record<string, string> = {
  fr: "Maxpeedingrods.lu est votre guide indépendant dédié aux groupes électrogènes Maxpeedingrods disponibles en France. Notre mission : vous aider à choisir le générateur inverter portable adapté à vos besoins, que ce soit pour le camping en pleine nature, l'alimentation de secours à domicile ou l'utilisation sur un chantier professionnel. La gamme Maxpeedingrods couvre des puissances allant de 1200W à 5500W, avec des modèles comme le compact MXR1500 pour les escapades en camping-car, le polyvalent MXR3500 plébiscité pour son rapport qualité-prix, ou le puissant MXR5500 capable d'alimenter une maison entière lors d'une coupure de courant. La technologie inverter intégrée à chaque générateur garantit un courant stable et propre, idéal pour vos appareils électroniques sensibles comme les ordinateurs, smartphones et équipements médicaux. Silencieux, économes en carburant et faciles à transporter, les générateurs Maxpeedingrods sont plébiscités par des milliers d'utilisateurs en France et en Europe. Nos fiches produits détaillées incluent les caractéristiques techniques complètes, les avis clients vérifiés et les meilleures offres du moment. Consultez nos comparatifs pour trouver le groupe électrogène Maxpeedingrods qui correspond parfaitement à vos exigences de puissance, de mobilité et de budget.",
  en: "Maxpeedingrods.lu is your independent guide to Maxpeedingrods portable generators available in the UK. Whether you need reliable backup power for your home, a quiet generator for caravanning and camping trips, or a robust unit for job sites, our detailed reviews and comparisons help you find the right model. The Maxpeedingrods range spans from 1200W to 5500W, including the lightweight MXR1500 perfect for weekend camping, the versatile MXR3500 praised by contractors and RV enthusiasts alike, and the powerful MXR5500 that can keep an entire household running during a power cut. Every Maxpeedingrods generator features advanced inverter technology, delivering clean and stable electricity safe for sensitive electronics like laptops, phones and medical devices. Fuel-efficient, remarkably quiet and built to last, these generators have earned the trust of thousands of customers across the UK and Europe. Is Maxpeedingrods a good brand? Our customer reviews speak for themselves — consistently high ratings across the entire range. Browse our product pages for full technical specifications, verified customer reviews and the best deals currently available. Compare models side by side to find the Maxpeedingrods generator that matches your power, portability and budget requirements.",
  de: "Maxpeedingrods.lu ist Ihr unabhängiger Ratgeber für tragbare Maxpeedingrods Stromerzeuger in Deutschland. Ob als Notstromaggregat für Ihr Zuhause, als leiser Inverter Generator für den Campingurlaub oder als zuverlässige Stromquelle auf der Baustelle — unsere ausführlichen Testberichte und Vergleiche helfen Ihnen, das passende Modell zu finden. Das Maxpeedingrods Sortiment umfasst Leistungsklassen von 1200W bis 5500W: vom kompakten MXR1500 ideal für Wohnmobil und Camping, über den vielseitigen MXR3500 der sowohl bei Handwerkern als auch bei Freizeitnutzern beliebt ist, bis zum leistungsstarken MXR5500 der ein ganzes Haus bei Stromausfall versorgen kann. Jeder Maxpeedingrods Stromerzeuger verfügt über moderne Inverter-Technologie, die sauberen und stabilen Strom liefert — sicher für empfindliche Elektronik wie Laptops, Smartphones und medizinische Geräte. Sparsam im Verbrauch, bemerkenswert leise und robust gebaut, haben diese Generatoren das Vertrauen tausender Kunden in Deutschland und Europa gewonnen. Unsere Erfahrungsberichte und Kundenbewertungen sprechen für sich: durchgehend hohe Bewertungen über die gesamte Produktpalette. Besuchen Sie unsere Produktseiten für vollständige technische Daten, verifizierte Kundenbewertungen und die besten aktuellen Angebote.",
  es: "Maxpeedingrods.lu es tu guía independiente de generadores portátiles Maxpeedingrods disponibles en España. Tanto si necesitas un generador de emergencia para tu hogar, un grupo electrógeno silencioso para acampar o una fuente de energía fiable para la obra, nuestras reseñas detalladas te ayudan a encontrar el modelo ideal. La gama Maxpeedingrods abarca potencias de 1200W a 5500W: desde el compacto MXR1500 perfecto para escapadas en autocaravana, pasando por el versátil MXR3500 valorado tanto por profesionales de la construcción como por campistas, hasta el potente MXR5500 capaz de alimentar una casa entera durante un corte de luz. Cada generador Maxpeedingrods incorpora tecnología inverter avanzada, proporcionando electricidad limpia y estable, segura para dispositivos electrónicos sensibles como portátiles, teléfonos móviles y equipos médicos. Eficientes en consumo de combustible, notablemente silenciosos y construidos para durar, estos generadores se han ganado la confianza de miles de clientes en España y Europa. ¿Es Maxpeedingrods una buena marca? Las opiniones de nuestros clientes hablan por sí solas, con valoraciones consistentemente altas en toda la gama. Consulta nuestras fichas de producto para especificaciones técnicas completas, opiniones verificadas y las mejores ofertas disponibles.",
  it: "Maxpeedingrods.lu è la vostra guida indipendente ai generatori portatili Maxpeedingrods disponibili in Italia. Che abbiate bisogno di un generatore di emergenza per la casa, di un gruppo elettrogeno silenzioso per il campeggio o di una fonte di energia affidabile per il cantiere, le nostre recensioni dettagliate vi aiutano a trovare il modello giusto. La gamma Maxpeedingrods copre potenze da 1200W a 5500W: dal compatto MXR1500 ideale per le vacanze in camper, al versatile MXR3500 apprezzato sia dai professionisti dell'edilizia che dai campeggiatori, fino al potente MXR5500 in grado di alimentare un'intera abitazione durante un blackout. Ogni generatore Maxpeedingrods è dotato di tecnologia inverter avanzata, che fornisce corrente pulita e stabile, sicura per dispositivi elettronici sensibili come laptop, smartphone e apparecchiature medicali. Efficienti nei consumi, notevolmente silenziosi e costruiti per durare, questi generatori si sono guadagnati la fiducia di migliaia di clienti in Italia e in Europa. Le nostre recensioni parlano chiaro: valutazioni costantemente elevate su tutta la gamma. Visitate le nostre schede prodotto per specifiche tecniche complete, recensioni verificate dei clienti e le migliori offerte attualmente disponibili.",
  nl: "Maxpeedingrods.lu is uw onafhankelijke gids voor draagbare Maxpeedingrods generatoren in Nederland. Of u nu betrouwbare noodstroom voor thuis zoekt, een stille generator voor kamperen of een robuust aggregaat voor de bouw — onze uitgebreide reviews en vergelijkingen helpen u het juiste model te vinden. Het Maxpeedingrods assortiment loopt van 1200W tot 5500W: van de compacte MXR1500 ideaal voor weekendjes kamperen, via de veelzijdige MXR3500 die geliefd is bij zowel aannemers als camperaars, tot de krachtige MXR5500 die een heel huishouden draaiende kan houden tijdens een stroomstoring. Elke Maxpeedingrods generator beschikt over geavanceerde invertertechnologie, die schone en stabiele stroom levert — veilig voor gevoelige elektronica zoals laptops, smartphones en medische apparatuur. Zuinig in verbruik, opmerkelijk stil en gebouwd om lang mee te gaan, hebben deze generatoren het vertrouwen gewonnen van duizenden klanten in Nederland en Europa. Onze klantreviews spreken voor zich: consistent hoge beoordelingen over het hele assortiment. Bekijk onze productpagina's voor volledige technische specificaties, geverifieerde klantbeoordelingen en de beste aanbiedingen van dit moment.",
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  url: siteConfig.url,
  description: seo.description,
};
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  locale={locale}
  canonicalPath={`/${locale}/`}
>
  <StructuredData data={websiteSchema} />

  <!-- 1. HERO — SEO-optimized H1 per language -->
  <Hero locale={locale} />
  <TrustBanner locale={locale} />
  <FeaturedProducts locale={locale} />

  <!-- 4. WHY MAXPEEDINGRODS — enriched with intro paragraph -->
  <WhyChoose locale={locale} />
  <HomeReviews locale={locale} />

  <!-- SEO Text -->
  <section class="py-14 relative" style="background: linear-gradient(180deg, #f8f9fb 0%, #ffffff 100%);">
    <div class="container-main">
      <div class="max-w-4xl mx-auto">
        <div class="h-[2px] w-16 bg-gradient-to-r from-brand-yellow to-brand-yellow-light rounded-full mb-6"></div>
        <p class="text-text-secondary text-sm leading-relaxed">
          {seoTexts[locale] || seoTexts.fr}
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
