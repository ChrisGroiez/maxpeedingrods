---
import type { Locale } from '../../i18n/utils';
import { t } from '../../i18n/utils';
import { getAffiliateLink } from '../../config/affiliates';

interface Props {
  locale: Locale;
  asin: string;
  productName: string;
}

const { locale, asin, productName } = Astro.props;
const href = getAffiliateLink(locale, asin);
---

<div
  id="sticky-cta"
  class="fixed bottom-0 left-0 right-0 z-40 bg-white border-t border-ui-border shadow-[0_-4px_12px_rgba(0,0,0,0.1)] p-3 md:hidden translate-y-full transition-transform duration-300"
>
  <a
    href={href}
    target="_blank"
    rel="nofollow noopener sponsored"
    class="btn-cta w-full text-base"
  >
    {t(locale, 'product.see_offer')}
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
    </svg>
  </a>
</div>

<script>
  const stickyCta = document.getElementById('sticky-cta');
  if (stickyCta) {
    let lastScrollY = window.scrollY;
    const showThreshold = 300;

    function updateSticky() {
      if (window.scrollY > showThreshold) {
        stickyCta!.classList.remove('translate-y-full');
        stickyCta!.classList.add('translate-y-0');
      } else {
        stickyCta!.classList.add('translate-y-full');
        stickyCta!.classList.remove('translate-y-0');
      }
      lastScrollY = window.scrollY;
    }

    window.addEventListener('scroll', updateSticky, { passive: true });
  }
</script>
