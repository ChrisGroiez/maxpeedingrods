---
import type { Product } from '../../utils/products';
import type { Locale } from '../../i18n/utils';
import { t } from '../../i18n/utils';
import { getProductUrl } from '../../utils/url';
import { getProductAsin } from '../../utils/products';
import ReviewStars from './ReviewStars.astro';
import AffiliateButton from './AffiliateButton.astro';

interface Props {
  product: Product;
  locale: Locale;
}

const { product, locale } = Astro.props;
const productUrl = getProductUrl(product.slug, locale);
const asin = getProductAsin(product, locale);
---

<article class="product-card flex flex-col h-full">
  <!-- Image section -->
  <a href={productUrl} class="block relative group">
    <div class="bg-gradient-to-br from-gray-50 to-gray-100 rounded-t-2xl p-5 overflow-hidden">
      <div class="aspect-[4/3] flex items-center justify-center">
        <img
          src={product.images[0]}
          alt={`${product.brand} ${product.model}`}
          width="400"
          height="300"
          loading="lazy"
          class="object-contain w-full h-full product-image-hover"
        />
      </div>
    </div>
    <!-- Inverter badge overlay -->
    {product.specs.inverter && (
      <span class="absolute top-3 left-3 inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-semibold bg-brand-yellow/90 text-brand-black backdrop-blur-sm">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        Inverter
      </span>
    )}
  </a>

  <!-- Content -->
  <div class="flex flex-col flex-1 p-5">
    <a href={productUrl} class="group">
      <h3 class="font-heading font-semibold text-text-primary text-lg group-hover:text-brand-yellow transition-colors duration-200">
        {product.brand} {product.model}
      </h3>
      <p class="text-text-secondary text-sm mt-1">
        {product.specs.inverter ? t(locale, 'product.category_badge') : 'Generator'} {product.specs.rated_power_w}W
      </p>
    </a>

    <!-- Stars -->
    <div class="mt-3">
      <ReviewStars rating={product.rating} count={product.reviewCount} size="sm" />
    </div>

    <!-- Quick specs with icons -->
    <div class="flex flex-wrap gap-3 mt-3">
      <span class="inline-flex items-center gap-1 text-xs text-text-muted bg-gray-50 px-2 py-1 rounded-md">
        <svg class="w-3.5 h-3.5 text-brand-yellow/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        {product.specs.rated_power_w}W
      </span>
      <span class="inline-flex items-center gap-1 text-xs text-text-muted bg-gray-50 px-2 py-1 rounded-md">
        <svg class="w-3.5 h-3.5 text-brand-yellow/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15.536a5 5 0 010-7.072m-2.828 9.9a9 9 0 010-12.728" />
        </svg>
        {product.specs.noise_level_db} dB
      </span>
      <span class="inline-flex items-center gap-1 text-xs text-text-muted bg-gray-50 px-2 py-1 rounded-md">
        <svg class="w-3.5 h-3.5 text-brand-yellow/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
        </svg>
        {product.specs.weight_kg} kg
      </span>
    </div>

    <!-- CTA -->
    <div class="mt-auto pt-5">
      <AffiliateButton locale={locale} asin={asin} fullWidth={true} />
    </div>
  </div>
</article>
