---
import type { ProductSpecs as Specs } from '../../utils/products';
import type { Locale } from '../../i18n/utils';
import { t } from '../../i18n/utils';

interface Props {
  specs: Specs;
  locale: Locale;
}

const { specs, locale } = Astro.props;

const rows = [
  { key: 'rated_power', value: `${specs.rated_power_w}W` },
  { key: 'max_power', value: `${specs.max_power_w}W` },
  { key: 'engine_type', value: specs.engine_type },
  { key: 'engine_displacement', value: `${specs.engine_displacement_cc} cc` },
  { key: 'fuel_type', value: specs.fuel_type },
  { key: 'fuel_tank', value: `${specs.fuel_tank_l} L` },
  { key: 'runtime', value: `${specs.runtime_hours}h` },
  { key: 'noise_level', value: `${specs.noise_level_db} dB` },
  { key: 'weight', value: `${specs.weight_kg} kg` },
  { key: 'dimensions', value: specs.dimensions_cm },
  { key: 'outlets', value: specs.outlets.join(', ') },
  { key: 'inverter', value: specs.inverter ? t(locale, 'product.yes') : t(locale, 'product.no') },
  { key: 'electric_start', value: specs.electric_start ? t(locale, 'product.yes') : t(locale, 'product.no') },
  { key: 'parallel_ready', value: specs.parallel_ready ? t(locale, 'product.yes') : t(locale, 'product.no') },
];
---

<div class="overflow-hidden rounded-xl border border-ui-border">
  <table class="w-full text-sm">
    <tbody>
      {rows.map((row, index) => (
        <tr class={index % 2 === 0 ? 'bg-ui-light' : 'bg-white'}>
          <td class="px-4 py-3 font-body font-medium text-text-secondary w-2/5">
            {t(locale, `product.${row.key}`)}
          </td>
          <td class="px-4 py-3 font-body text-text-primary">
            {row.value}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
