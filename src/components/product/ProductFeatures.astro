---

{features.length > 0 && (
  <section class="mt-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {features.map((feature) => (
        <div class="group rounded-2xl overflow-hidden border border-gray-100 bg-white transition-all duration-300 hover:shadow-lg hover:border-brand-yellow/20">
          <div class="aspect-[16/10] overflow-hidden bg-gray-50">
            <img
              src={feature.image}
              alt={feature.title}
              width="600"
              height="375"
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>
          <div class="p-5">
            <h3 class="font-heading font-bold text-base md:text-lg text-text-primary mb-2">{feature.title}</h3>
            <p class="text-sm text-text-secondary leading-relaxed">{feature.description}</p>
