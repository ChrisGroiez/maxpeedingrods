---
interface Props {
  images: string[];
  productName: string;
}

const { images, productName } = Astro.props;
const mainImage = images[0];
---

<div class="product-gallery" id="product-gallery">
  <!-- Main image -->
  <div class="relative rounded-2xl overflow-hidden" style="background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);">
    <div class="aspect-square flex items-center justify-center p-8">
      <img
        id="gallery-main-img"
        src={mainImage}
        alt={productName}
        width="600"
        height="600"
        class="object-contain w-full h-full transition-transform duration-500"
      />
    </div>
  </div>

  <!-- Thumbnails -->
  {images.length > 1 && (
    <div class="flex gap-3 mt-4">
      {images.map((img, index) => (
        <button
          type="button"
          class:list={[
            'gallery-thumb w-16 h-16 lg:w-20 lg:h-20 rounded-xl overflow-hidden p-1.5 transition-all duration-200 hover:ring-2 hover:ring-brand-yellow/50',
            index === 0 ? 'ring-2 ring-brand-yellow bg-white scale-105' : 'ring-1 ring-gray-200 bg-gray-50',
          ]}
          data-src={img}
          data-index={index}
        >
          <img
            src={img}
            alt={`${productName} - ${index + 1}`}
            width="80"
            height="80"
            loading="lazy"
            class="object-contain w-full h-full"
          />
        </button>
      ))}
    </div>
  )}
</div>

<script>
  const mainImg = document.getElementById('gallery-main-img') as HTMLImageElement | null;
  const thumbs = document.querySelectorAll('.gallery-thumb');

  thumbs.forEach(thumb => {
    thumb.addEventListener('click', () => {
      const src = (thumb as HTMLElement).dataset.src;
      if (mainImg && src) {
        mainImg.src = src;
        thumbs.forEach(t => {
          t.classList.remove('ring-brand-yellow', 'bg-white', 'scale-105');
          t.classList.remove('ring-2');
          t.classList.add('ring-1', 'ring-gray-200', 'bg-gray-50');
        });
        thumb.classList.remove('ring-1', 'ring-gray-200', 'bg-gray-50');
        thumb.classList.add('ring-2', 'ring-brand-yellow', 'bg-white', 'scale-105');
      }
    });
  });
</script>
