---
interface Props {
  images: string[];
  productName: string;
}

const { images, productName } = Astro.props;
const mainImage = images[0];
---

<div class="product-gallery" id="product-gallery">
  <!-- Main image -->
  <div class="bg-gray-50 rounded-xl overflow-hidden aspect-square flex items-center justify-center p-6">
    <img
      id="gallery-main-img"
      src={mainImage}
      alt={productName}
      width="600"
      height="600"
      class="object-contain w-full h-full"
    />
  </div>

  <!-- Thumbnails -->
  {images.length > 1 && (
    <div class="flex gap-3 mt-4">
      {images.map((img, index) => (
        <button
          type="button"
          class:list={[
            'gallery-thumb w-16 h-16 lg:w-20 lg:h-20 rounded-lg overflow-hidden border-2 p-1.5 bg-gray-50 transition-all duration-200 hover:border-brand-yellow',
            index === 0 ? 'border-brand-yellow' : 'border-gray-200',
          ]}
          data-src={img}
          data-index={index}
        >
          <img
            src={img}
            alt={`${productName} - ${index + 1}`}
            width="80"
            height="80"
            loading="lazy"
            class="object-contain w-full h-full"
          />
        </button>
      ))}
    </div>
  )}
</div>

<script>
  const mainImg = document.getElementById('gallery-main-img') as HTMLImageElement | null;
  const thumbs = document.querySelectorAll('.gallery-thumb');

  thumbs.forEach(thumb => {
    thumb.addEventListener('click', () => {
      const src = (thumb as HTMLElement).dataset.src;
      if (mainImg && src) {
        mainImg.src = src;
        thumbs.forEach(t => t.classList.replace('border-brand-yellow', 'border-gray-200'));
        thumb.classList.replace('border-gray-200', 'border-brand-yellow');
      }
    });
  });
</script>
