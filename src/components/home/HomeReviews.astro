---
import type { Locale } from '../../i18n/utils';
import { t } from '../../i18n/utils';
import { getAllProducts } from '../../utils/products';
import { getCategoryUrl } from '../../utils/url';
import ReviewStars from '../product/ReviewStars.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// Calculate aggregate rating across all products
const products = getAllProducts();
const totalReviews = products.reduce((sum, p) => sum + p.reviewCount, 0);
const weightedRating = products.reduce((sum, p) => sum + p.rating * p.reviewCount, 0) / totalReviews;
const avgRating = Math.round(weightedRating * 10) / 10;

// Load best reviews for homepage (4 reviews from different products, matching locale)
interface Review {
  id: string;
  author: string;
  date: string;
  rating: number;
  title: string;
  content: string;
  lang: string;
  verified: boolean;
}

interface ReviewFile {
  slug: string;
  reviews: Review[];
}

const reviewModules = import.meta.glob<ReviewFile>('../../data/reviews/*.json', { eager: true, import: 'default' });
const allReviews: (Review & { productSlug: string })[] = [];

for (const [, data] of Object.entries(reviewModules)) {
  if (data?.reviews) {
    for (const review of data.reviews) {
      if (review.lang === locale && review.rating >= 4) {
        allReviews.push({ ...review, productSlug: data.slug });
      }
    }
  }
}

// Pick 4 best reviews from different products
const selectedReviews: (Review & { productSlug: string })[] = [];
const usedProducts = new Set<string>();

// Sort by rating desc, then pick from different products
const sorted = allReviews.sort((a, b) => b.rating - a.rating);
for (const review of sorted) {
  if (selectedReviews.length >= 4) break;
  if (!usedProducts.has(review.productSlug)) {
    selectedReviews.push(review);
    usedProducts.add(review.productSlug);
  }
}

// If we don't have 4 yet, fill from remaining
if (selectedReviews.length < 4) {
  for (const review of sorted) {
    if (selectedReviews.length >= 4) break;
    if (!selectedReviews.includes(review)) {
      selectedReviews.push(review);
    }
  }
}

const productMap = Object.fromEntries(products.map(p => [p.slug, p]));
---

<section class="py-12 md:py-16 lg:py-20 bg-ui-light">
  <div class="container-main">
    <div class="text-center mb-8 md:mb-12">
      <h2 class="font-heading font-bold text-2xl md:text-3xl text-text-primary">
        {t(locale, 'home.reviews_title')}
      </h2>
      <p class="mt-2 text-text-secondary font-body">
        {t(locale, 'home.reviews_subtitle')}
      </p>

      <!-- Aggregate rating -->
      <div class="mt-4 flex items-center justify-center gap-3">
        <ReviewStars rating={avgRating} count={totalReviews} size="lg" />
        <span class="font-heading font-bold text-2xl text-text-primary">{avgRating}/5</span>
      </div>
    </div>

    <!-- Reviews grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 max-w-4xl mx-auto">
      {selectedReviews.map(review => {
        const product = productMap[review.productSlug];
        return (
          <div class="bg-white rounded-xl p-5 shadow-sm border border-ui-border">
            <div class="flex items-center justify-between mb-3">
              <ReviewStars rating={review.rating} showCount={false} size="sm" />
              {review.verified && (
                <span class="text-xs text-status-success font-medium flex items-center gap-1">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {t(locale, 'reviews_section.verified')}
                </span>
              )}
            </div>
            <h3 class="font-heading font-semibold text-text-primary text-sm mb-1">{review.title}</h3>
            <p class="text-text-secondary text-sm leading-relaxed line-clamp-3">{review.content}</p>
            <div class="mt-3 flex items-center justify-between text-xs text-text-muted">
              <span class="font-medium">{review.author}</span>
              {product && (
                <span>{product.model}</span>
              )}
            </div>
          </div>
        );
      })}
    </div>

    <!-- Link to category -->
    <div class="text-center mt-8">
      <a href={getCategoryUrl(locale)} class="inline-flex items-center gap-2 text-brand-yellow hover:text-brand-yellow-dark font-heading font-semibold transition-colors">
        {t(locale, 'product.reviews')}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
