---
import type { Locale } from '../../i18n/utils';
import { t } from '../../i18n/utils';
import { getFeaturedProducts } from '../../utils/products';
import ProductCard from '../product/ProductCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const featured = getFeaturedProducts();
---

<section class="py-12 md:py-16 lg:py-20">
  <div class="container-main">
    <h2 class="font-heading font-bold text-2xl md:text-3xl text-text-primary text-center">
      {t(locale, 'home.featured_title')}
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 mt-8 md:mt-12">
      {featured.map(product => (
        <ProductCard product={product} locale={locale} />
      ))}
    </div>
  </div>
</section>
