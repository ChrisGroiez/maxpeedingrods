---
import type { Locale } from '../../i18n/utils';
import { t } from '../../i18n/utils';
import { getCategoryUrl } from '../../utils/url';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const statsLabels: Record<string, { models: string; range: string; delivery: string }> = {
  fr: { models: '7 modèles', range: '1200W – 5500W', delivery: 'Livraison rapide' },
  en: { models: '7 models', range: '1200W – 5500W', delivery: 'Fast delivery' },
  de: { models: '7 Modelle', range: '1200W – 5500W', delivery: 'Schnelle Lieferung' },
  es: { models: '7 modelos', range: '1200W – 5500W', delivery: 'Envío rápido' },
  it: { models: '7 modelli', range: '1200W – 5500W', delivery: 'Consegna rapida' },
  nl: { models: '7 modellen', range: '1200W – 5500W', delivery: 'Snelle levering' },
};

const stats = statsLabels[locale] || statsLabels.fr;

const badgeLabels: Record<string, string> = {
  fr: 'Générateurs Inverter Portables',
  en: 'Portable Inverter Generators',
  de: 'Tragbare Inverter-Stromerzeuger',
  es: 'Generadores Inverter Portátiles',
  it: 'Generatori Inverter Portatili',
  nl: 'Draagbare Inverter Generatoren',
};
---

<section class="relative overflow-hidden">
  <!-- Background banner images -->
  <div class="absolute inset-0" aria-hidden="true">
    <!-- Mobile banner -->
    <img
      src="/images/brand/Banniere-principale-mobile.avif"
      alt=""
      class="md:hidden absolute inset-0 w-full h-full object-cover"
    />
    <!-- Desktop banner -->
    <img
      src="/images/brand/banniere-page-acceuil.avif"
      alt=""
      class="hidden md:block absolute inset-0 w-full h-full object-cover"
    />
    <!-- Dark overlay for text readability -->
    <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(11,15,26,0.80) 0%, rgba(17,24,39,0.70) 40%, rgba(26,31,46,0.75) 100%);"></div>
  </div>

  <!-- Decorative elements over the image -->
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    <!-- Subtle yellow glow -->
    <div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] rounded-full opacity-[0.05]" style="background: radial-gradient(circle, #F5A623 0%, transparent 70%); filter: blur(80px);"></div>

    <!-- Geometric decorative shapes -->
    <div class="absolute top-16 left-[10%] w-20 h-20 border border-brand-yellow/10 rounded-lg rotate-45 animate-float"></div>
    <div class="absolute bottom-20 right-[15%] w-16 h-16 border border-brand-yellow/8 rounded-full" style="animation: float 8s ease-in-out infinite 2s;"></div>
    <div class="absolute top-1/3 right-[8%] w-2 h-2 bg-brand-yellow/20 rounded-full" style="animation: float 5s ease-in-out infinite 1s;"></div>
    <div class="absolute bottom-1/3 left-[5%] w-3 h-3 bg-brand-yellow/15 rounded-full" style="animation: float 7s ease-in-out infinite 3s;"></div>
  </div>

  <div class="container-main relative z-10 py-20 md:py-28 lg:py-36">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Badge pill -->
      <div class="animate-fade-in-up inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-brand-yellow/20 bg-brand-yellow/5 mb-6">
        <div class="w-1.5 h-1.5 rounded-full bg-brand-yellow animate-pulse"></div>
        <span class="text-brand-yellow text-sm font-medium font-heading">{badgeLabels[locale] || badgeLabels.fr}</span>
      </div>

      <!-- Title with gradient -->
      <h1 class="animate-fade-in-up delay-100 font-heading font-bold text-4xl md:text-5xl lg:text-6xl xl:text-7xl leading-[1.1] tracking-tight">
        <span class="text-text-inverse">{t(locale, 'home.hero_title').split(' ').slice(0, -1).join(' ')} </span>
        <span class="gradient-text">{t(locale, 'home.hero_title').split(' ').pop()}</span>
      </h1>

      <!-- Subtitle -->
      <p class="animate-fade-in-up delay-200 mt-5 md:mt-6 text-base md:text-lg lg:text-xl text-gray-400 font-body leading-relaxed max-w-2xl mx-auto">
        {t(locale, 'home.hero_subtitle')}
      </p>

      <!-- CTA Button -->
      <div class="animate-fade-in-up delay-300 mt-8 md:mt-10">
        <a href={getCategoryUrl(locale)} class="btn-cta text-base md:text-lg animate-pulse-glow">
          {t(locale, 'home.hero_cta')}
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Stats bar -->
      <div class="animate-fade-in-up delay-400 mt-10 md:mt-14 flex flex-wrap items-center justify-center gap-6 md:gap-8">
        <div class="flex items-center gap-2 text-gray-400">
          <svg class="w-5 h-5 text-brand-yellow/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span class="text-sm font-medium">{stats.models}</span>
        </div>
        <div class="hidden sm:block w-px h-4 bg-gray-600"></div>
        <div class="flex items-center gap-2 text-gray-400">
          <svg class="w-5 h-5 text-brand-yellow/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span class="text-sm font-medium">{stats.range}</span>
        </div>
        <div class="hidden sm:block w-px h-4 bg-gray-600"></div>
        <div class="flex items-center gap-2 text-gray-400">
          <svg class="w-5 h-5 text-brand-yellow/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
          </svg>
          <span class="text-sm font-medium">{stats.delivery}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom gradient fade -->
  <div class="absolute bottom-0 left-0 right-0 h-24" style="background: linear-gradient(to top, #F9FAFB 0%, transparent 100%);"></div>
</section>
