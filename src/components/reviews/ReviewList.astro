---
import type { Locale } from '../../i18n/utils';
import ReviewCard from './ReviewCard.astro';

interface Review {
  id: string;
  author: string;
  date: string;
  rating: number;
  title: string;
  content: string;
  lang: string;
  verified: boolean;
}

interface Props {
  reviews: Review[];
  locale: Locale;
}

const { reviews, locale } = Astro.props;
const filteredReviews = reviews.filter(r => r.lang === locale);
---

<div class="space-y-4">
  {filteredReviews.map(review => (
    <ReviewCard review={review} locale={locale} />
  ))}
</div>
