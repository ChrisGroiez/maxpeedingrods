---
import type { Locale } from '../../i18n/utils';
import { t } from '../../i18n/utils';
import ReviewStars from '../product/ReviewStars.astro';

interface Props {
  review: {
    id: string;
    author: string;
    date: string;
    rating: number;
    title: string;
    content: string;
    lang: string;
    verified: boolean;
  };
  locale: Locale;
}

const { review, locale } = Astro.props;

const dateFormatted = new Date(review.date).toLocaleDateString(locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="bg-white rounded-xl p-5 border border-ui-border">
  <div class="flex items-start justify-between gap-4">
    <div>
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-full bg-brand-yellow/10 flex items-center justify-center text-brand-yellow font-heading font-bold text-sm">
          {review.author.charAt(0).toUpperCase()}
        </div>
        <div>
          <span class="font-body font-medium text-text-primary text-sm">{review.author}</span>
          {review.verified && (
            <span class="inline-flex items-center gap-1 ml-2 text-xs text-status-success">
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              {t(locale, 'reviews_section.verified')}
            </span>
          )}
        </div>
      </div>
    </div>
    <time class="text-xs text-text-muted whitespace-nowrap">{dateFormatted}</time>
  </div>

  <div class="mt-3">
    <ReviewStars rating={review.rating} showCount={false} size="sm" />
  </div>

  <h4 class="font-heading font-semibold text-text-primary text-base mt-3">{review.title}</h4>
  <p class="text-text-secondary text-sm mt-2 leading-relaxed">{review.content}</p>
</article>
