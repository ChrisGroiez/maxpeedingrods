---
import type { Locale } from '../../i18n/utils';
import { locales } from '../../i18n/utils';
import { siteConfig } from '../../config/site';
import { getCanonicalUrl } from '../../utils/url';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  canonicalPath: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  locale,
  canonicalPath,
  ogImage = '/images/brand/og-default.webp',
  ogType = 'website',
  noindex = false,
} = Astro.props;

const canonicalUrl = getCanonicalUrl(canonicalPath);
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteConfig.url}${ogImage}`;

function getAlternatePath(basePath: string, currentLocale: Locale, targetLocale: string): string {
  return basePath.replace(`/${currentLocale}/`, `/${targetLocale}/`);
}
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Canonical -->
<link rel="canonical" href={canonicalUrl} />

<!-- Hreflang -->
{locales.map(lang => (
  <link
    rel="alternate"
    hreflang={lang}
    href={getCanonicalUrl(getAlternatePath(canonicalPath, locale, lang))}
  />
))}
<link rel="alternate" hreflang="x-default" href={getCanonicalUrl(getAlternatePath(canonicalPath, locale, 'fr'))} />

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:type" content={ogType} />
<meta property="og:locale" content={locale} />
<meta property="og:site_name" content={siteConfig.name} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Favicon -->
<link rel="icon" type="image/avif" href="/images/brand/Favicon-MXR.avif" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

<!-- Generator -->
<meta name="generator" content={Astro.generator} />
